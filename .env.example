# Copy to .env.local and fill in your own values. Never commit .env.local.
ORIGIN_POSTCODE=YOUR_POSTCODE
# Optional coordinates; configure.mjs resolves the postcode if these are empty.
ORIGIN_LATITUDE=
ORIGIN_LONGITUDE=
SEARCH_RADIUS_MILES=40
DEFAULT_MAX_DRIVE_MINUTES=60

# Optional custom-domain adapter and existing deployment bindings.
LAKEBED_ORIGIN=
CUSTOM_DOMAIN_ORIGIN=
LAKEBED_DEPLOY_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=dangler-proxy
